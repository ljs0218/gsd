# Monsters: stats are dotted columns (stats.*); drops are a child sheet (monsters.drops) pointing at items with ref(item).
# chance is in basis points (10000 = always).
@enum element = none | fire | ice | poison
@ref item = items.gsd#items.id label=name icon=icon
@doc monsters.stats.hp = Maximum HP
@doc monsters.drops.chance = Drop chance in basis points (10000 = always)

@sheet monsters key=id
id:str     | name:str    | icon:str | element:enum(element) | stats.hp:int | stats.atk:int | stats.def:int | stats.speed:num
slime      | Green Slime | 🟢        | poison                | 30           | 4             | 1             | 0.8
cave_bat   | Cave Bat    | 🦇        | none                  | 22           | 6             | 0             | 1.6
ember_imp  | Ember Imp   | 👺        | fire                  | 80           | 14            | 4             | 1.1
frost_wolf | Frost Wolf  | 🐺        | ice                   | 140          | 19            | 7             | 1.3

@sheet monsters.drops
^          | item:ref(item) | chance:int | min:int | max:int
slime      | slime_gel      | 6000       | 1       | 2
slime      | healing_potion | 800        | 1       | 1
cave_bat   | slime_gel      | 1500       | 1       | 1
ember_imp  | ember_staff    | 150        | 1       | 1
ember_imp  | mana_draught   | 1800       | 1       | 1
frost_wolf | iron_mail      | 600        | 1       | 1
frost_wolf | moonpetal      | 200        | 1       | 1
